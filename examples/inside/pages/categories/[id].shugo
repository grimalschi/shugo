---
import ProductCard from "../../components/ProductCard.shugo"

export function getStaticPaths({ query }) {
  return query("categories").select("id").all().map((row) => ({ params: { id: row.id } }))
}

const category = Shugo.query("categories").get(Shugo.params.id)
const products = Shugo.query("products").select("id").where({ category: category.id }).order("title").all()
---
<title slot="head">{category.title} — Pottery Shop</title>
<h1>{category.title}</h1>
<g-for each={products} as="product"><ProductCard id={product.id} /></g-for>
