---
import Badge from "../../components/Badge.shugo"
import ProductCard from "../../components/ProductCard.shugo"
import Variant from "../../components/Variant.shugo"
import { finalPrice, price } from "../../lib/money"

// The pages get their addresses alone; each asks for its product itself.
// So one product that changes has one page computed, not the list of all.
export function getStaticPaths({ query }) {
  return query("products").all().map(({ slug }) => ({ params: { slug } }))
}

// No query names its columns: a page depends on what is read of the rows,
// here and in the template, and on nothing else of them.
const item = Shugo.query("products").where({ slug: Shugo.params.slug }).first()
const badges = Shugo.query("badges").where({ product: item.id }).order("position").all()
const variants = Shugo.query("variants").where({ product: item.id }).order("position").all()
const reviews = Shugo.query("reviews").where({ product: item.id, approved: true }).all()
const related = Shugo.query("related").where({ product: item.id }).order("position").all()
const cost = finalPrice(item)
---
<title slot="head">{item.title} — Measure</title>
<h1>{item.title}</h1>
<p class="badges"><g-for each={badges} as="badge"><Badge text={badge.text} /></g-for></p>
<p class="price">
  <g-if cond={item.discount}>
    <s>{price(item.price)}</s>
    <strong>{price(cost)}</strong>
    <span>−{item.discount}% to {item.discount_until}</span>
  </g-if>
  <g-else><strong>{price(item.price)}</strong></g-else>
</p>
<g-if cond={item.available}><p class="stock">In stock</p></g-if>
<g-else><p class="stock">Available to order; arriving {item.arrival}</p></g-else>
<p>{item.description}</p>
<ul class="variants">
  <g-for each={variants} as="variant"><Variant variant={variant} /></g-for>
</ul>
<section class="reviews">
  <h2>Reviews: {reviews.length}</h2>
  <g-for each={reviews} as="review">
    <blockquote><p>{review.text}</p><small>{review.author}</small></blockquote>
  </g-for>
</section>
<g-if cond={related.length}>
  <section class="related">
    <h2>Frequently bought together</h2>
    <ul class="cards">
      <g-for each={related} as="one"><li><ProductCard id={one.other} /></li></g-for>
    </ul>
  </section>
</g-if>
