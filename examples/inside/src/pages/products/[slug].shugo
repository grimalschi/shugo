<script module>
  // The route gives the addresses; every page asks for its product itself.
  export function getStaticPaths({ query }) {
    return query("products").select("slug").all().map((row) => ({ params: { slug: row.slug } }))
  }
</script>

<script>
  import Variant from "../../components/Variant.shugo"
  import { price } from "../../lib/money"

  const item = Shugo.query("products").where({ slug: Shugo.params.slug }).first()
  const variants = Shugo.query("variants").where({ product: item.id }).order("position").all()
</script>

<svelte:head><title>{item.title} — Pottery Shop</title></svelte:head>
<h1>{item.title}</h1>
<p class="price">{price(item.price)}</p>
<ul>
  {#each variants as variant}<Variant {variant} />{/each}
</ul>
