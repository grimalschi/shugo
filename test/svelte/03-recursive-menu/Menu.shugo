<script lang="ts">
  import Menu from "./Menu.shugo";
  type Item = { label: string; href: string; active?: boolean; children?: Item[] };
  let { items, depth = 1 }: { items: Item[]; depth?: number } = $props();
</script>

{#if items.length > 0}
  <ul class="menu level-{depth}">
    {#each items as item}
      {@const nested = (item.children?.length ?? 0) > 0}
      <li class={[item.active && "active", nested && "has-children"]}>
        <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
        {#if nested}<Menu items={item.children ?? []} depth={depth + 1} />{/if}
      </li>
    {/each}
  </ul>
{/if}
