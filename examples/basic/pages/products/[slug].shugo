---
import { formatPrice, products, type Product } from "../../lib/shop"

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}

const { product } = Shugo.props as { product: Product }
---
<title slot="head">{product.title}</title>
<h1>{product.title}</h1>
<p class="price">{formatPrice(product.price)}</p>
<g-if cond={product.discount}>
  <p>Discount {product.discount}%</p>
</g-if>
<g-else-if cond={product.price > 1000}>
  <p>Free shipping</p>
</g-else-if>
<g-else>
  <p>Shipping: $300</p>
</g-else>
<ul>
  <g-for each={product.tags} as="tag"><li>{tag}</li></g-for>
</ul>
<p><a href="/">← Catalog</a> · address: {Shugo.url.pathname}, parameter: {Shugo.params.slug}</p>
