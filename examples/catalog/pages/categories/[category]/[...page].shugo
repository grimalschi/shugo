---
import ProductCard from "../../../components/ProductCard.shugo"

// Every category is a list of pages, 24 products on each. The route counts
// the products to know how many pages there are; every page asks for its
// own products.
export function getStaticPaths({ query, paginate }) {
  return query("categories").select("id").all().flatMap(({ id }) =>
    paginate(query("products").where({ category: id }).count(), { pageSize: 24, params: { category: id } }),
  )
}

const category = Shugo.query("categories").select("title").get(Shugo.params.category)
const page = Shugo.paginate(Shugo.query("products").select("id").where({ category: category.id }).order("position"), { pageSize: 24 })
---
<title slot="head">{category.title} — Measure</title>
<h1>{category.title}</h1>
<p>Products: {page.total}. Page {page.currentPage} of {page.lastPage}.</p>
<ul class="cards">
  <g-for each={page.data} as="item"><li><ProductCard id={item.id} /></li></g-for>
</ul>
<nav class="pages">
  <g-if cond={page.url.prev}><a href={page.url.prev}>← Previous</a></g-if>
  <g-if cond={page.url.next}><a href={page.url.next}>Next →</a></g-if>
</nav>
