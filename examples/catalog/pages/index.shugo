---
import ProductCard from "../components/ProductCard.shugo"

const first = Shugo.query("products").order("position").limit(24).all()
---
<title slot="head">Measure — handmade tableware</title>
<h1>New in the catalog</h1>
<ul class="cards">
  <g-for each={first} as="item"><li><ProductCard id={item.id} /></li></g-for>
</ul>
