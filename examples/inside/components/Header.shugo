---
// The header stands on every page. It is called with no parameters, so it is
// a shared block: computed once for the whole site.
const shop = Shugo.query("shop").get(1)
const menu = Shugo.query("categories").order("position").all()
---
<header>
  <a href="/">{shop.name}</a>
  <nav>
    <g-for each={menu} as="category">
      <a href={`/categories/${category.id}`}>{category.title} ({Shugo.query("products").where({ category: category.id }).count()})</a>
    </g-for>
  </nav>
</header>
