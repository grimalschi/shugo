---
import Card from "../components/Card.shugo"
import { getProducts } from "../lib/shop"

const products = await getProducts()
---
<title slot="head">Catalog</title>
<h1>Catalog</h1>
<g-for each={products} as="product" index="i">
  <Card product={product} featured={i === 0}>
    <g-if cond={product.tags.length > 0}>
      <small>{product.tags.join(", ")}</small>
    </g-if>
  </Card>
</g-for>
